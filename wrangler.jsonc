{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "blujaylabs-website",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"KEYSTATIC_GITHUB_CLIENT_ID": "Ov23licWqAwqa6b3o8Q3",
		// Enquiry + newsletter notifications (src/lib/mailer.ts). NOTIFY_FROM's domain
		// must be onboarded: `wrangler email sending enable bluejoylabs.com`.
		"NOTIFY_TO": "connect@bluejoylabs.com",
		"NOTIFY_FROM": "website@bluejoylabs.com"
	},
	// Cloudflare Email Service. Locked to the one inbox, so the public forms can
	// never be used to send mail to anyone else.
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_destination_addresses": ["connect@bluejoylabs.com"]
		}
	],
	"env": {
		"preview": {
			"name": "blujaylabs-website-preview",
			"observability": {
				"enabled": true
			},
			"vars": {
				"NOTIFY_TO": "connect@bluejoylabs.com",
				"NOTIFY_FROM": "website@bluejoylabs.com"
			},
			"send_email": [
				{
					"name": "EMAIL",
					"allowed_destination_addresses": ["connect@bluejoylabs.com"]
				}
			]
		}
	}
}
