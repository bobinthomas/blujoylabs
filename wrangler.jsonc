{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "blujaylabs-website",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"KEYSTATIC_GITHUB_CLIENT_ID": "Ov23licWqAwqa6b3o8Q3"
	},
	"env": {
		"preview": {
			"name": "blujaylabs-website-preview",
			"observability": {
				"enabled": true
			}
		}
	}
}
