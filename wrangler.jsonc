{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "blujaylabs-website",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-22",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Production domains. Custom domains create their own DNS records and SSL
	// certificates; www redirects to the bare domain (next.config.ts).
	// The site lives only on blujoylabs.com; a second public copy on workers.dev
	// would compete with it in search results.
	"workers_dev": false,
	"routes": [
		{ "pattern": "blujoylabs.com", "custom_domain": true },
		{ "pattern": "www.blujoylabs.com", "custom_domain": true }
	],
	"vars": {
		"KEYSTATIC_GITHUB_CLIENT_ID": "Ov23licWqAwqa6b3o8Q3",
		// Enquiry + newsletter notifications via Resend (src/lib/mailer.ts). NOTIFY_FROM's
		// domain must be verified in Resend; the API key is the RESEND_API_KEY secret.
		"NOTIFY_TO": "connect@blujoylabs.com",
		"NOTIFY_FROM": "website@blujoylabs.com"
	},
	"env": {
		"preview": {
			"name": "blujaylabs-website-preview",
			"observability": {
				"enabled": true
			},
			"vars": {
				"NOTIFY_TO": "connect@blujoylabs.com",
				"NOTIFY_FROM": "website@blujoylabs.com"
			}
		}
	}
}
